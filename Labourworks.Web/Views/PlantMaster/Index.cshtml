@{
    ViewData["Title"] = "Plant Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

<style>
    :root {
        --pm-primary: #4f46e5;
        --pm-primary-dark: #4338ca;
        --pm-text: #172033;
        --pm-muted: #64748b;
        --pm-border: #e5eaf2;
        --pm-bg: #f5f7fb;
    }

    .plant-page {
        min-height: calc(100vh - 80px);
        padding: 26px;
        color: var(--pm-text);
        background: var(--pm-bg);
        border-radius: 12px;
    }

        .plant-page * {
            box-sizing: border-box;
        }

    .plant-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 23px;
        color: #8792a5;
        font-size: 12px;
    }

        .plant-breadcrumb .current {
            color: var(--pm-primary);
            font-weight: 700;
        }

    .plant-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 24px;
    }

    .plant-heading-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .plant-heading-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #dfe4ff;
        border-radius: 13px;
        background: #eef0ff;
        color: var(--pm-primary);
        font-size: 23px;
    }

    .plant-heading {
        margin: 0;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -.5px;
    }

    .plant-description {
        margin: 7px 0 0;
        color: var(--pm-muted);
        font-size: 12px;
    }

    .plant-btn {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 650;
        transition: .2s;
    }

    .plant-btn-primary {
        color: #fff;
        background: var(--pm-primary);
        border: 1px solid var(--pm-primary);
    }

        .plant-btn-primary:hover {
            color: #fff;
            background: var(--pm-primary-dark);
            border-color: var(--pm-primary-dark);
        }

    .plant-btn-secondary,
    .plant-btn-refresh {
        color: #475569;
        background: #fff;
        border: 1px solid #dce3ed;
    }

        .plant-btn-secondary:hover,
        .plant-btn-refresh:hover {
            color: var(--pm-primary);
            background: #f8f9ff;
            border-color: #c7d2fe;
        }

    .plant-stats {
        margin-bottom: 23px;
    }

    .plant-stat-card {
        height: 100%;
        padding: 19px;
        border: 1px solid var(--pm-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15,23,42,.025);
    }

    .plant-stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .plant-stat-label {
        color: var(--pm-muted);
        font-size: 12px;
        font-weight: 600;
    }

    .plant-stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 19px;
    }

    .stat-total .plant-stat-icon {
        color: #4f46e5;
        background: #eef0ff;
    }

    .stat-active .plant-stat-icon {
        color: #15803d;
        background: #eaf8ef;
    }

    .stat-inactive .plant-stat-icon {
        color: #64748b;
        background: #f1f5f9;
    }

    .plant-stat-number {
        display: block;
        margin-top: 13px;
        color: var(--pm-text);
        font-size: 29px;
        font-weight: 750;
    }

    .plant-stat-caption {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 11px;
    }

    .plant-card {
        overflow: hidden;
        margin-bottom: 23px;
        border: 1px solid var(--pm-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15,23,42,.025);
    }

    .plant-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px 23px;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

    .plant-card-title {
        margin: 0;
        color: var(--pm-text);
        font-size: 15px;
        font-weight: 750;
    }

        .plant-card-title i {
            margin-right: 8px;
            color: var(--pm-primary);
        }

    .plant-card-subtitle {
        margin: 6px 0 0;
        color: #8792a5;
        font-size: 12px;
    }

    .plant-card-body {
        padding: 23px;
    }

    .plant-form-section {
        padding: 19px;
        border: 1px solid #edf0f5;
        border-radius: 10px;
        background: #fcfdff;
    }

    .plant-section-title {
        margin-bottom: 20px;
        color: #334155;
        font-size: 12px;
        font-weight: 750;
    }

        .plant-section-title i {
            margin-right: 8px;
            color: var(--pm-primary);
        }

    .plant-label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 12px;
        font-weight: 650;
    }

    .plant-required {
        color: #dc2626;
    }

    .plant-input {
        width: 100%;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        outline: none;
        background: #fff;
        color: #1e293b;
        font-size: 12px;
    }

        .plant-input::placeholder {
            color: #a0aabc;
        }

        .plant-input:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(99,102,241,.10);
        }

        .plant-input.is-invalid {
            border-color: #dc3545;
        }

    .plant-error {
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }

    .plant-status-box {
        min-height: 60px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 10px 13px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
    }

        .plant-status-box .form-check-input {
            margin: 0;
            cursor: pointer;
        }

            .plant-status-box .form-check-input:checked {
                background-color: var(--pm-primary);
                border-color: var(--pm-primary);
            }

        .plant-status-box label {
            cursor: pointer;
        }

    .plant-status-help {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
    }

    .plant-form-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 19px;
    }

    .plant-mode {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border: 1px solid #e0e7ff;
        border-radius: 20px;
        background: #f5f5ff;
        color: #4f46e5;
        font-size: 10px;
        font-weight: 700;
    }

    .plant-mode-dot,
    .plant-dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
        background: currentColor;
    }

    .plant-count {
        padding: 7px 10px;
        border: 1px solid #e0e7ff;
        border-radius: 7px;
        background: #f5f5ff;
        color: #4f46e5;
        font-size: 11px;
        font-weight: 700;
    }

    .plant-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .plant-table {
        width: 100% !important;
        margin: 0 !important;
        border-spacing: 0;
        font-size: 12px;
    }

        .plant-table thead th {
            padding: 15px 19px !important;
            border-bottom: 1px solid #e8edf4 !important;
            background: #f8fafc;
            color: #64748b;
            font-size: 10px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .plant-table tbody td {
            padding: 13px 19px !important;
            border-bottom: 1px solid #f0f2f7 !important;
            vertical-align: middle;
            color: #475569;
            background: #fff;
        }

        .plant-table tbody tr:hover td {
            background: #fafbff;
        }

        .plant-table tbody tr:last-child td {
            border-bottom: 0 !important;
        }

    .plant-slno {
        color: #94a3b8;
        font-size: 11px;
    }

    .plant-name-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 180px;
    }

    .plant-icon {
        width: 37px;
        height: 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #e0e7ff;
        border-radius: 9px;
        background: #f0f2ff;
        color: var(--pm-primary);
        font-size: 17px;
    }

    .plant-name-text {
        color: #243047;
        font-size: 12px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .plant-name-caption {
        display: block;
        margin-top: 4px;
        color: #9aa5b5;
        font-size: 10px;
    }

    .plant-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .plant-badge-active {
        border: 1px solid #ccebd6;
        background: #effaf2;
        color: #16803d;
    }

    .plant-badge-inactive {
        border: 1px solid #e2e8f0;
        background: #f5f7fa;
        color: #64748b;
    }

    .plant-row-actions {
        display: flex;
        justify-content: center;
        gap: 7px;
    }

    .plant-action {
        width: 33px;
        height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        transition: .2s;
    }

    .plant-edit {
        color: #4f46e5;
    }

        .plant-edit:hover {
            background: #eef2ff;
            border-color: #c7d2fe;
        }

    .plant-delete {
        color: #dc2626;
    }

        .plant-delete:hover {
            background: #fff1f2;
            border-color: #fecaca;
        }

    .plant-page .dataTables_wrapper {
        padding: 17px 20px;
    }

        .plant-page .dataTables_wrapper .row {
            align-items: center;
            row-gap: 12px;
        }

        .plant-page .dataTables_wrapper .dataTables_length,
        .plant-page .dataTables_wrapper .dataTables_filter {
            color: #64748b;
            font-size: 11px;
        }

            .plant-page .dataTables_wrapper .dataTables_length label,
            .plant-page .dataTables_wrapper .dataTables_filter label {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
            }

            .plant-page .dataTables_wrapper .dataTables_length select {
                width: 70px;
                height: 35px;
                margin: 0;
                padding: 5px 20px 5px 9px;
                border: 1px solid #dce3ed;
                border-radius: 7px;
                background-color: #fff;
                color: #334155;
                font-size: 11px;
            }

            .plant-page .dataTables_wrapper .dataTables_filter input {
                width: 215px;
                height: 35px;
                margin: 0 !important;
                padding: 8px 11px;
                border: 1px solid #dce3ed;
                border-radius: 7px;
                outline: none;
                font-size: 11px;
            }

                .plant-page .dataTables_wrapper .dataTables_filter input:focus {
                    border-color: #818cf8;
                    box-shadow: 0 0 0 3px rgba(99,102,241,.09);
                }

        .plant-page .dataTables_wrapper .dataTables_info {
            padding-top: 12px;
            color: #94a3b8;
            font-size: 11px;
        }

        .plant-page .dataTables_wrapper .dataTables_paginate {
            padding-top: 7px;
        }

            .plant-page .dataTables_wrapper .dataTables_paginate .paginate_button {
                margin: 0 2px;
                padding: 6px 10px !important;
                border: 1px solid #e2e8f0 !important;
                border-radius: 7px !important;
                background: #fff !important;
                color: #64748b !important;
                font-size: 11px;
                box-shadow: none !important;
            }

                .plant-page .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                .plant-page .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                    border-color: var(--pm-primary) !important;
                    background: var(--pm-primary) !important;
                    color: #fff !important;
                }

                .plant-page .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    border-color: #c7d2fe !important;
                    background: #eef2ff !important;
                    color: #4338ca !important;
                }

    #loader {
        display: none;
        padding: 28px;
        text-align: center;
        color: #64748b;
        font-size: 12px;
    }

    .plant-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 18px 60px rgba(15,23,42,.18);
    }

    .plant-modal .modal-header {
        padding: 20px 23px;
        border-bottom: 1px solid #e9edf4;
        background: #f8f9ff;
    }

    .plant-modal .modal-body {
        padding: 24px;
    }

    .plant-modal .modal-footer {
        padding: 15px 23px;
        border-top: 1px solid #edf0f5;
        background: #fcfdff;
    }

    .plant-modal-title {
        margin: 0;
        color: #172033;
        font-size: 16px;
        font-weight: 750;
    }

    .plant-modal-subtitle {
        margin: 5px 0 0;
        color: #8792a5;
        font-size: 11px;
    }

    @@media (max-width: 767px) {
        .plant-page {
            padding: 14px;
        }

        .plant-heading {
            font-size: 21px;
        }

        .plant-heading-icon {
            width: 42px;
            height: 42px;
            font-size: 20px;
        }

        .plant-page-header {
            align-items: flex-start;
        }

        .plant-header-actions {
            width: 100%;
        }

            .plant-header-actions .plant-btn {
                flex: 1;
            }

        .plant-stat-card {
            padding: 15px;
        }

        .plant-stat-number {
            font-size: 25px;
        }

        .plant-card-header {
            padding: 16px;
        }

        .plant-card-body {
            padding: 15px;
        }

        .plant-form-section {
            padding: 14px;
        }

        .plant-page .dataTables_wrapper {
            padding: 14px;
        }

            .plant-page .dataTables_wrapper .dataTables_length,
            .plant-page .dataTables_wrapper .dataTables_filter {
                width: 100%;
            }

                .plant-page .dataTables_wrapper .dataTables_filter label {
                    width: 100%;
                }

                .plant-page .dataTables_wrapper .dataTables_filter input {
                    width: 100%;
                    min-width: 0;
                    flex: 1;
                }

            .plant-page .dataTables_wrapper .dataTables_info {
                text-align: center;
            }

            .plant-page .dataTables_wrapper .dataTables_paginate {
                display: flex;
                justify-content: center;
                width: 100%;
            }

        .plant-modal .modal-body {
            padding: 19px;
        }
    }
</style>

<div class="container-fluid plant-page">

    <!-- Breadcrumb stays visible -->
    <nav class="plant-breadcrumb" aria-label="Breadcrumb">
        <i class="bi bi-grid"></i>
        <span>Administration</span>
        <i class="bi bi-chevron-right"></i>
        <span>Master Data</span>
        <i class="bi bi-chevron-right"></i>
        <span class="current">Plant Master</span>
    </nav>

    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="plant-page-header">
        <div class="plant-heading-group">
            <div class="plant-heading-icon">
                <i class="bi bi-buildings"></i>
            </div>
            <div>
                <h1 class="plant-heading">Plant Master</h1>
          
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 plant-header-actions">


            <button type="button" id="addPlantBtn"
                    class="btn plant-btn plant-btn-primary">
                <i class="bi bi-plus-lg"></i> Add New Plant
            </button>
        </div>
    </div>



    <!-- Add Plant Section: hidden initially -->
    <div class="card plant-card" id="plantFormCard" style="display:none;">
        <div class="plant-card-header">
            <div>
                <h5 class="plant-card-title" id="formTitle">
                    <i class="bi bi-plus-square"></i> Add Plant
                </h5>
                <p class="plant-card-subtitle" id="formSubtitle">
                    Enter the details to register a new plant.
                </p>
            </div>
            <span class="plant-mode" id="formMode">
                <span class="plant-mode-dot"></span> New Record
            </span>
        </div>

        <div class="plant-card-body">
            <form id="plantForm" autocomplete="off">
                <input type="hidden" id="PlantId" value="0" />

                <div class="plant-form-section">
                    <div class="plant-section-title">
                        <i class="bi bi-card-list"></i> Plant Information
                    </div>

                    <div class="row g-4 align-items-start">
                        <div class="col-12 col-lg-7">
                            <label for="PlantName" class="plant-label">
                                Plant Name <span class="plant-required">*</span>
                            </label>
                            <input type="text" id="PlantName" name="PlantName"
                                   class="plant-input" maxlength="150"
                                   placeholder="Enter plant name" required />
                            <div id="plantNameError" class="plant-error"></div>
                        </div>

                        <div class="col-12 col-lg-5">
                            <label class="plant-label">Plant Status</label>
                            <div class="plant-status-box">
                                <input type="checkbox" id="IsActive"
                                       name="IsActive" class="form-check-input" checked />
                                <label for="IsActive" class="mb-0">
                                    <strong id="statusLabel"
                                            style="font-size:12px;">Active</strong>
                                    <span class="plant-status-help" id="statusHelp">
                                        This plant is available for use.
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="plant-form-actions">
                    <button type="button" id="cancelBtn"
                            class="btn plant-btn plant-btn-secondary">
                        <i class="bi bi-x-lg"></i> Cancel
                    </button>
                    <button type="submit" id="submitBtn"
                            class="btn plant-btn plant-btn-primary">
                        <i class="bi bi-check2-circle"></i> Save Plant
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Plant List: visible initially -->
    <div class="card plant-card">
        <div class="plant-card-header">
            <div>
                <h5 class="plant-card-title">
                    <i class="bi bi-list-ul"></i> Registered Plants
                </h5>
         
            </div>
            <span class="plant-count">
                <i class="bi bi-database"></i>
                <span id="listCount">0 Records</span>
            </span>
        </div>



        <div class="plant-table-wrap">
            <table id="plantTable" class="table plant-table common-datatable">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Plant Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="plantTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Plant Modal -->
<div class="modal fade plant-modal" id="editPlantModal" tabindex="-1"
     aria-labelledby="editPlantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="plant-modal-title" id="editPlantModalLabel">
                        <i class="bi bi-pencil-square me-2"
                           style="color:#4f46e5;"></i> Edit Plant
                    </h5>
                    <p class="plant-modal-subtitle">
                        Update the selected plant information.
                    </p>
                </div>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="editPlantForm" autocomplete="off">
                <div class="modal-body">
                    <input type="hidden" id="EditPlantId" />

                    <div class="mb-4">
                        <label for="EditPlantName" class="plant-label">
                            Plant Name <span class="plant-required">*</span>
                        </label>
                        <input type="text" id="EditPlantName"
                               class="plant-input" maxlength="150"
                               placeholder="Enter plant name" required />
                        <div id="editPlantNameError" class="plant-error"></div>
                    </div>

                    <div>
                        <label class="plant-label">Plant Status</label>
                        <div class="plant-status-box">
                            <input type="checkbox" id="EditIsActive"
                                   class="form-check-input" checked />
                            <label for="EditIsActive" class="mb-0">
                                <strong id="editStatusLabel"
                                        style="font-size:12px;">Active</strong>
                                <span class="plant-status-help" id="editStatusHelp">
                                    This plant is available for use.
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn plant-btn plant-btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" id="editSubmitBtn"
                            class="btn plant-btn plant-btn-primary">
                        <i class="bi bi-check2-circle"></i> Update Plant
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

            let plantData = [];
            let plantTable = null;
            let editModal = null;

            // Bootstrap 5 modal
            if (window.bootstrap) {
                editModal = new bootstrap.Modal(
                    document.getElementById('editPlantModal')
                );
            } else {
                console.error('Bootstrap 5 JavaScript is not loaded in _Layout.cshtml.');
            }

            function getToken() {
                return $('input[name="__RequestVerificationToken"]').val();
            }

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : String(value)).html();
            }

            function showError(message) {
                if (window.Swal) {
                    Swal.fire('Error', message, 'error');
                } else {
                    alert(message);
                }
            }

            function showSuccess(title, message, callback) {
                if (window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: title,
                        text: message,
                        confirmButtonColor: '#4f46e5'
                    }).then(function () {
                        if (callback) callback();
                    });
                } else {
                    alert(message);
                    if (callback) callback();
                }
            }

            function updateStatistics(data) {
                const total = data.length;
                const active = data.filter(function (item) {
                    return item.isActive === true;
                }).length;

                $('#totalPlants').text(total);
                $('#activePlants').text(active);
                $('#inactivePlants').text(total - active);
                $('#listCount').text(
                    total + (total === 1 ? ' Record' : ' Records')
                );
            }


            function loadPlants() {
                $('#loader').show();
                $('#refreshBtn').prop('disabled', true);

                $.ajax({
                    url: '/PlantMaster/GetAll',
                    type: 'GET',
                    cache: false,

                    success: function (response) {
                        if (!response || response.status !== true) {
                            plantData = [];
                            updateStatistics([]);
                            renderTable([]);
                            return;
                        }

                        plantData = response.data || [];
                        updateStatistics(plantData);
                        renderTable(plantData);
                    },

                    error: function (xhr) {
                        console.error(xhr.responseText);
                        plantData = [];
                        updateStatistics([]);

                        if ($.fn.DataTable.isDataTable('#plantTable')) {
                            $('#plantTable').DataTable().destroy();
                        }

                        plantTable = null;
                        $('#plantTableBody').html(`
                            <tr>
                                <td colspan="4" class="text-center text-danger py-4">
                                    Unable to load plants. Please click Refresh.
                                </td>
                            </tr>
                        `);
                    },

                    complete: function () {
                        $('#loader').hide();
                        $('#refreshBtn').prop('disabled', false);
                    }
                });
            }

            // Render the data table
            function renderTable(data) {
                if ($.fn.DataTable.isDataTable('#plantTable')) {
                    $('#plantTable').DataTable().destroy();
                }

                plantTable = null;
                let rows = '';

                $.each(data, function (index, item) {
                    const name = escapeHtml(item.plantName || '');
                    const id = escapeHtml(item.plantId);

                    const status = item.isActive === true
                        ? `<span class="plant-badge plant-badge-active">
                               <span class="plant-dot"></span> Active
                           </span>`
                        : `<span class="plant-badge plant-badge-inactive">
                               <span class="plant-dot"></span> Inactive
                           </span>`;

                    rows += `
                        <tr>
                            <td><span class="plant-slno">${index + 1}</span></td>
                            <td>
                                <div class="plant-name-cell">
                                    <span class="plant-icon">
                                        <i class="bi bi-building"></i>
                                    </span>
                                    <div>
                                        <div class="plant-name-text">${name}</div>
                                        <span class="plant-name-caption">Plant Master Record</span>
                                    </div>
                                </div>
                            </td>
                            <td>${status}</td>
                            <td>
                                <div class="plant-row-actions">
                                    <button type="button"
                                            class="plant-action plant-edit editBtn"
                                            data-id="${id}" title="Edit Plant">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button"
                                            class="plant-action plant-delete deleteBtn"
                                            data-id="${id}" title="Delete Plant">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                });

                $('#plantTableBody').html(rows);

                plantTable = $('#plantTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: false,
                    order: [],
                    dom: '<"row align-items-center g-3 mb-3"<"col-12 col-md-6"l><"col-12 col-md-6"f>>rt<"row align-items-center g-2 mt-2"<"col-12 col-md-5"i><"col-12 col-md-7"p>>',
                    language: {
                        emptyTable: 'No plant records available',
                        zeroRecords: 'No matching plants found',
                        search: '',
                        searchPlaceholder: 'Search plant name...',
                        lengthMenu: 'Show _MENU_ entries',
                        info: 'Showing _START_ to _END_ of _TOTAL_ plants',
                        infoEmpty: 'Showing 0 to 0 of 0 plants',
                        infoFiltered: '(filtered from _MAX_ total plants)',
                        paginate: {
                            first: 'First',
                            last: 'Last',
                            next: 'Next',
                            previous: 'Previous'
                        }
                    },
                    columnDefs: [
                        { targets: 0, orderable: false, searchable: false },
                        { targets: 3, orderable: false, searchable: false }
                    ]
                });

                // Keep serial numbers correct after search and pagination
                plantTable.on('draw.dt', function () {
                    const info = plantTable.page.info();

                    plantTable.column(0, {
                        page: 'current'
                    }).nodes().each(function (cell, i) {
                        cell.innerHTML =
                            '<span class="plant-slno">' +
                            (info.start + i + 1) +
                            '</span>';
                    });
                });

                plantTable.draw(false);
            }

            // Initial page load: form stays hidden
            loadPlants();

            // Open Add Plant form
            $('#addPlantBtn').on('click', function () {
                resetAddForm();

                $('#plantFormCard').stop(true, true).slideDown(200);

                $('html, body').animate({
                    scrollTop: $('#plantFormCard').offset().top - 80
                }, 250);

                setTimeout(function () {
                    $('#PlantName').trigger('focus');
                }, 250);
            });

            function resetAddForm() {
                $('#plantForm')[0].reset();
                $('#PlantId').val(0);
                $('#IsActive').prop('checked', true);
                $('#statusLabel').text('Active');
                $('#statusHelp').text('This plant is available for use.');

                $('#formTitle').html(
                    '<i class="bi bi-plus-square"></i> Add Plant'
                );
                $('#formSubtitle').text(
                    'Enter the details to register a new plant.'
                );
                $('#formMode').html(
                    '<span class="plant-mode-dot"></span> New Record'
                );
                $('#submitBtn')
                    .html('<i class="bi bi-check2-circle"></i> Save Plant')
                    .prop('disabled', false);

                $('#PlantName').removeClass('is-invalid');
                $('#plantNameError').text('');
            }

            function hideAddForm() {
                $('#plantFormCard').stop(true, true).slideUp(200);
                resetAddForm();
            }

            $('#cancelBtn').on('click', function () {
                hideAddForm();
            });

            $('#IsActive').on('change', function () {
                const active = $(this).is(':checked');
                $('#statusLabel').text(active ? 'Active' : 'Inactive');
                $('#statusHelp').text(active
                    ? 'This plant is available for use.'
                    : 'This plant is marked as inactive.');
            });

            // Save new plant
            $('#plantForm').on('submit', function (e) {
                e.preventDefault();

                const name = $('#PlantName').val().trim();
                const active = $('#IsActive').is(':checked');

                $('#PlantName').removeClass('is-invalid');
                $('#plantNameError').text('');

                if (!name) {
                    $('#PlantName').addClass('is-invalid');
                    $('#plantNameError').text('Plant name is required.');
                    $('#PlantName').trigger('focus');
                    return;
                }

                const duplicate = plantData.some(function (plant) {
                    return String(plant.plantName || '').trim().toLowerCase()
                        === name.toLowerCase();
                });

                if (duplicate) {
                    $('#PlantName').addClass('is-invalid');
                    $('#plantNameError').text('Plant name already exists.');
                    $('#PlantName').trigger('focus');
                    return;
                }

                const dto = {
                    PlantId: 0,
                    PlantName: name,
                    IsActive: active
                };

                $('#submitBtn').prop('disabled', true);

                $.ajax({
                    url: '/PlantMaster/Create',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(dto),
                    headers: {
                        'RequestVerificationToken': getToken()
                    },

                    success: function (response) {
                        if (response && response.status === true) {
                            showSuccess(
                                'Plant Created',
                                response.message || 'Plant saved successfully.',
                                function () {
                                    hideAddForm();
                                    loadPlants();
                                }
                            );
                        } else {
                            showError(response?.message || 'Unable to save plant.');
                        }
                    },

                    error: function (xhr) {
                        console.error(xhr.responseText);
                        showError(xhr.responseJSON?.message ||
                            'An error occurred while saving the plant.');
                    },

                    complete: function () {
                        $('#submitBtn').prop('disabled', false);
                    }
                });
            });

            $('#PlantName').on('input', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid');
                    $('#plantNameError').text('');
                }
            });

            // Open Edit modal with selected record
            $('#plantTable').on('click', '.editBtn', function () {
                const id = $(this).attr('data-id');

                const item = plantData.find(function (plant) {
                    return String(plant.plantId) === String(id);
                });

                if (!item) {
                    showError('Plant record not found.');
                    return;
                }

                $('#EditPlantId').val(item.plantId);
                $('#EditPlantName').val(item.plantName || '');
                $('#EditIsActive').prop('checked', item.isActive === true);

                $('#editStatusLabel').text(
                    item.isActive === true ? 'Active' : 'Inactive'
                );

                $('#editStatusHelp').text(
                    item.isActive === true
                        ? 'This plant is available for use.'
                        : 'This plant is marked as inactive.'
                );

                $('#EditPlantName').removeClass('is-invalid');
                $('#editPlantNameError').text('');
                $('#editSubmitBtn')
                    .html('<i class="bi bi-check2-circle"></i> Update Plant')
                    .prop('disabled', false);

                if (editModal) {
                    editModal.show();
                } else {
                    showError('Bootstrap modal is unavailable. Check _Layout.cshtml.');
                }
            });

            $('#EditIsActive').on('change', function () {
                const active = $(this).is(':checked');

                $('#editStatusLabel').text(active ? 'Active' : 'Inactive');
                $('#editStatusHelp').text(active
                    ? 'This plant is available for use.'
                    : 'This plant is marked as inactive.');
            });

            // Update plant from modal
            $('#editPlantForm').on('submit', function (e) {
                e.preventDefault();

                const id = parseInt($('#EditPlantId').val() || '0', 10);
                const name = $('#EditPlantName').val().trim();
                const active = $('#EditIsActive').is(':checked');

                $('#EditPlantName').removeClass('is-invalid');
                $('#editPlantNameError').text('');

                if (!name) {
                    $('#EditPlantName').addClass('is-invalid');
                    $('#editPlantNameError').text('Plant name is required.');
                    $('#EditPlantName').trigger('focus');
                    return;
                }

                const duplicate = plantData.some(function (plant) {
                    return String(plant.plantId) !== String(id) &&
                        String(plant.plantName || '').trim().toLowerCase()
                        === name.toLowerCase();
                });

                if (duplicate) {
                    $('#EditPlantName').addClass('is-invalid');
                    $('#editPlantNameError').text('Plant name already exists.');
                    $('#EditPlantName').trigger('focus');
                    return;
                }

                const dto = {
                    PlantId: id,
                    PlantName: name,
                    IsActive: active
                };

                $('#editSubmitBtn').prop('disabled', true);

                $.ajax({
                    url: '/PlantMaster/Update',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(dto),
                    headers: {
                        'RequestVerificationToken': getToken()
                    },

                    success: function (response) {
                        if (response && response.status === true) {
                            if (editModal) editModal.hide();

                            showSuccess(
                                'Plant Updated',
                                response.message || 'Plant updated successfully.',
                                function () {
                                    loadPlants();
                                }
                            );
                        } else {
                            showError(response?.message || 'Unable to update plant.');
                        }
                    },

                    error: function (xhr) {
                        console.error(xhr.responseText);
                        showError(xhr.responseJSON?.message ||
                            'An error occurred while updating the plant.');
                    },

                    complete: function () {
                        $('#editSubmitBtn').prop('disabled', false);
                    }
                });
            });

            $('#EditPlantName').on('input', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid');
                    $('#editPlantNameError').text('');
                }
            });

            // Delete confirmation
            $('#plantTable').on('click', '.deleteBtn', function () {
                const id = $(this).attr('data-id');

                const item = plantData.find(function (plant) {
                    return String(plant.plantId) === String(id);
                });

                if (!item) {
                    showError('Plant record not found.');
                    return;
                }

                const confirmDelete = function () {
                    $.ajax({
                        url: '/PlantMaster/Delete?id=' + encodeURIComponent(id),
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': getToken()
                        },

                        success: function (response) {
                            if (response && response.status === true) {
                                showSuccess(
                                    'Plant Deleted',
                                    response.message || 'Plant deleted successfully.',
                                    function () {
                                        loadPlants();
                                    }
                                );
                            } else {
                                showError(response?.message || 'Unable to delete plant.');
                            }
                        },

                        error: function (xhr) {
                            console.error(xhr.responseText);
                            showError(xhr.responseJSON?.message ||
                                'An error occurred while deleting the plant.');
                        }
                    });
                };

                if (window.Swal) {
                    Swal.fire({
                        title: 'Delete Plant?',
                        text: 'Are you sure you want to delete "' +
                            item.plantName + '"?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Yes, delete',
                        cancelButtonText: 'Cancel'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            confirmDelete();
                        }
                    });
                } else if (confirm(
                    'Are you sure you want to delete "' + item.plantName + '"?'
                )) {
                    confirmDelete();
                }
            });

            // Refresh
            $('#refreshBtn').on('click', function () {
                loadPlants();
            });
        });
    </script>
}
