@model Labourworks.Domain.Entities.PlantMaster

@{
    ViewData["Title"] = "Add Plant";
}

<div class="card">

    <div class="card-header bg-primary text-white">
        <h4>Add Plant</h4>
    </div>

    <div class="card-body">

        @Html.AntiForgeryToken()

        <div id="msg"></div>

        <div class="row">



            <div class="col-md-6 mb-3">
                <label class="form-label">Plant Name</label>
                <input type="text" id="PlantName" class="form-control" />
                <span id="PlantNameError" class="text-danger"></span>
            </div>

        </div>

        <div class="d-flex justify-content-end gap-2">

        <button type="button"
                id="btnSave"
                class="btn btn-success">

            <i class="bi bi-check-circle"></i>

            Save

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

       

            $("#PlantName").keyup(function () {
                $("#PlantNameError").text("");
            });

       
            $("#btnSave").click(function () {

                var isValid = true;

             

                if ($("#PlantName").val().trim() == "") {
                    $("#PlantNameError").text("Plant Name is required.");
                    isValid = false;
                }


                if (!isValid)
                    return;

                var model = {

                 

                    PlantName: $("#PlantName").val(),


                    IsActive: $("#IsActive").is(":checked")

                };

                $.ajax({

                    url: "/PlantMaster/Create",

                    type: "POST",

                    headers: {
                        "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                    },

                    data: model,

                    success: function (response) {

                        if (response.status) {

                            alert(response.message);

                            window.location.href="/PlantMaster/Index";
                        }
                        else {

                            alert(response.message);

                        }

                    },

                    error: function () {

                        alert("Something went wrong.");

                    }

                });

            });

        });

    </script>

}