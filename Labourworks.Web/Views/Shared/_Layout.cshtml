@{
    ViewData["Title"] ??= "Dashboard";
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Labourworks</title>


    <!-- =========================
         Bootstrap CSS
    ========================== -->
    <link href="~/css/custom.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/datatable-common.css"
          asp-append-version="true" />

    <!-- =========================
         Bootstrap Icons
    ========================== -->
    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/bootstrap-icons.css"
          asp-append-version="true" />


    <!-- =========================
         DataTables Bootstrap 5 CSS
    ========================== -->
    <link rel="stylesheet"
          href="~/datatable/css/datatables.bootstrap5.min.css"
          asp-append-version="true" />

    <!-- =========================
    Sweet alrert css
        ========================== -->
    <link href="~/css/sweetalert2.css" rel="stylesheet" />

    <!-- =========================
         Application CSS
    ========================== -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/master-style.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-mini-width: 76px;
            --navy: #14213d;
            --navy-light: #1e3154;
            --blue: #2563eb;
            --page-bg: #f3f6fb;
            --text-main: #1e293b;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--page-bg);
            color: var(--text-main);
        }

        body {
            overflow-x: hidden;
        }

        /* APPLICATION */
        .app-wrapper {
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: var(--sidebar-width);
            z-index: 1040;
            overflow-x: hidden;
            overflow-y: auto;
            background: linear-gradient(180deg, #182740, #101a2d);
            color: #fff;
            box-shadow: 4px 0 18px rgba(15, 23, 42, .08);
            transition: width .25s ease, transform .25s ease;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #52627b;
                border-radius: 8px;
            }

        .sidebar-header {
            min-height: 126px;
            padding: 18px 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: #111c30;
            border-bottom: 1px solid rgba(255,255,255,.09);
        }

        .poc-rail__logo {
            width: 56px;
            height: 56px;
            margin: 0 auto 10px;
            padding: 5px;
            display: grid;
            place-items: center;
            background: #fff;
            border-radius: 10px;
        }

            .poc-rail__logo img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .sidebar-title {
            margin: 0;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
        }

        .sidebar-subtitle {
            margin-top: 5px;
            color: #a8b5c9;
            font-size: 11px;
        }

        .sidebar .nav {
            padding: 12px 0 20px;
        }

        .sidebar .nav-item {
            width: 100%;
        }

        .sidebar .nav-link {
            min-height: 44px;
            padding: 11px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #cbd5e1;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
            transition: background .2s, color .2s;
        }

            .sidebar .nav-link > i:first-child {
                min-width: 22px;
                width: 22px;
                text-align: center;
                font-size: 17px;
            }

            .sidebar .nav-link:hover {
                color: #fff;
                background: rgba(255,255,255,.08);
            }

            .sidebar .nav-link.active {
                color: #fff;
                background: rgba(37,99,235,.22);
                border-right: 3px solid #60a5fa;
            }

        .nav-label {
            padding: 17px 18px 7px;
            color: #8494ad;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .nav-divider {
            height: 1px;
            margin: 8px 17px;
            background: rgba(255,255,255,.12);
        }

        .submenu {
            padding: 4px 0 8px;
            background: rgba(0,0,0,.12);
        }

        .sidebar .submenu .nav-link {
            min-height: 38px;
            padding: 9px 10px 9px 50px;
            font-size: 12px;
        }

        .submenu-arrow {
            margin-left: auto;
            font-size: 11px;
        }

        /* MAIN CONTENT */
        .main-content {
            min-height: 100vh;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            transition: margin-left .25s ease;
        }

        /* PROFESSIONAL HEADER */
        .top-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            min-height: 72px;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            background: #0a58ca;
            border-bottom: 1px solid #e5eaf2;
            box-shadow: 0 3px 12px rgba(15,23,42,.04);
        }

        .header-left,
        .header-right,
        .header-page-info {
            display: flex;
            align-items: center;
        }

        .header-left {
            gap: 15px;
            min-width: 0;
        }

        .header-page-info {
            gap: 12px;
            min-width: 0;
        }

        .header-right {
            gap: 12px;
            flex-shrink: 0;
        }

        .sidebar-toggle {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            color: #334155;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            font-size: 22px;
            cursor: pointer;
        }

            .sidebar-toggle:hover {
                color: var(--blue);
                background: #eff6ff;
            }

        .header-page-icon {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            color: var(--blue);
            background: #eff6ff;
            border-radius: 11px;
            font-size: 18px;
        }

        .header-page-title {
            margin: 0;
            color: #fff;
            font-size: 17px;
            font-weight: 700;
        }

        .header-page-subtitle {
            margin-top: 3px;
            color: #8490a3;
            font-size: 11px;
        }

        /* FONT CONTROLS */
        .font-controls {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
        }

        .font-control-btn {
            min-width: 36px;
            height: 32px;
            padding: 0 7px;
            color: #334155;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

            .font-control-btn:hover {
                color: var(--blue);
                background: #eff6ff;
            }

        /* USER BUTTON */
        .user-dropdown-btn {
            min-height: 44px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 10px;
            background: #f8fafc;
            border: 1px solid #dbe4f0;
            border-radius: 11px;
            color: #334155;
        }

            .user-dropdown-btn:hover,
            .user-dropdown-btn:focus {
                background: #eff6ff;
                border-color: #bfdbfe;
            }

        .user-avatar {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            border-radius: 50%;
            font-size: 17px;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .user-name {
            max-width: 150px;
            overflow: hidden;
            color: #1e293b;
            font-size: 12px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-role {
            margin-top: 2px;
            color: #8490a3;
            font-size: 11px;
        }

        /* PAGE */
        .page-content {
            flex: 1;
            min-width: 0;
            padding: 24px;
        }

        .page-footer {
            padding: 15px 24px;
            color: #8490a3;
            background: #fff;
            border-top: 1px solid #e5eaf2;
            font-size: 11px;
        }

        /* DESKTOP COLLAPSE */
        .app-wrapper.sidebar-collapsed .sidebar {
            width: var(--sidebar-mini-width);
        }

        .app-wrapper.sidebar-collapsed .main-content {
            margin-left: var(--sidebar-mini-width);
        }

        .app-wrapper.sidebar-collapsed .sidebar-title,
        .app-wrapper.sidebar-collapsed .sidebar-subtitle,
        .app-wrapper.sidebar-collapsed .nav-label,
        .app-wrapper.sidebar-collapsed .sidebar .nav-link span,
        .app-wrapper.sidebar-collapsed .submenu-arrow,
        .app-wrapper.sidebar-collapsed .sidebar .submenu {
            display: none !important;
        }

        .app-wrapper.sidebar-collapsed .sidebar .nav-link {
            justify-content: center;
            padding: 12px 5px;
        }

        .app-wrapper.sidebar-collapsed .sidebar-header {
            min-height: 85px;
            padding: 12px 5px;
        }

        .app-wrapper.sidebar-collapsed .poc-rail__logo {
            width: 44px;
            height: 44px;
            margin-bottom: 0;
        }

        /* MOBILE */
        .sidebar-overlay {
            display: none;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: var(--sidebar-width);
                transform: translateX(-100%);
            }

                .sidebar.mobile-open {
                    transform: translateX(0);
                }

            .main-content,
            .app-wrapper.sidebar-collapsed .main-content {
                margin-left: 0;
            }

            .app-wrapper.sidebar-collapsed .sidebar {
                width: var(--sidebar-width);
            }

                .app-wrapper.sidebar-collapsed .sidebar-title,
                .app-wrapper.sidebar-collapsed .sidebar-subtitle,
                .app-wrapper.sidebar-collapsed .nav-label,
                .app-wrapper.sidebar-collapsed .sidebar .nav-link span,
                .app-wrapper.sidebar-collapsed .submenu-arrow {
                    display: initial !important;
                }

                .app-wrapper.sidebar-collapsed .sidebar .submenu {
                    display: flex !important;
                }

                .app-wrapper.sidebar-collapsed .sidebar .nav-link {
                    justify-content: flex-start;
                    padding: 11px 18px;
                }

            .sidebar-overlay.show {
                display: block;
                position: fixed;
                inset: 0;
                z-index: 1035;
                background: rgba(15,23,42,.48);
            }

            .top-header {
                min-height: 64px;
                padding: 10px 12px;
                gap: 7px;
            }

            .header-left {
                gap: 8px;
            }

            .header-page-icon,
            .user-info {
                display: none;
            }

            .header-page-title {
                max-width: 120px;
                overflow: hidden;
                font-size: 14px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .header-page-subtitle {
                display: none;
            }

            .header-right {
                gap: 5px;
            }

            .font-controls {
                gap: 3px;
                padding: 3px;
            }

            .font-control-btn {
                min-width: 29px;
                padding: 0 4px;
            }

            .user-dropdown-btn {
                padding: 3px;
                gap: 4px;
            }

            .page-content {
                padding: 15px;
            }

            .page-footer {
                padding: 13px 15px;
            }
        }

        @@media (max-width: 390px) {
            .header-page-title {
                max-width: 85px;
            }

            .sidebar-toggle {
                width: 35px;
                height: 35px;
            }
        }
    </style>
</head>

<body>
    <div class="app-wrapper" id="appWrapper">

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="mainSidebar">
            <div class="sidebar-header">
                <div class="text-center">
                    <span class="poc-rail__logo">
                        <img src="~/Images/add-logo.png"
                             alt="Addsoft Technologies"
                             onerror="this.style.display='none';" />
                    </span>
                    <h5 class="sidebar-title">Contract Labour Management</h5>
   
                </div>
            </div>

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index"
                       title="Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-divider"></li>
                <li class="nav-label">Master Data</li>

                <li class="nav-item">
                    <a class="nav-link"
                       data-bs-toggle="collapse"
                       href="#masterMenu"
                       aria-expanded="@(controller == "Plant" ? "true" : "false")"
                       aria-controls="masterMenu">
                        <i class="bi bi-database"></i>
                        <span>Masters</span>
                        <i class="bi bi-chevron-down submenu-arrow"></i>
                    </a>

                    <div class="collapse @(controller == "Plant" ? "show" : "")"
                         id="masterMenu">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link @(controller == "PlantMaster" ? "active" : "")"
                                   asp-controller="PlantMaster" asp-action="Index"
                                   title="Plant Master">
                                    <i class="bi bi-building"></i>
                                    <span>Plant Master</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "ContractorMaster" ? "active" : "")"
                                   asp-controller="ContractorMaster"
                                   asp-action="Index"
                                   title="Contractor Master">

                                    <i class="bi bi-people-fill"></i>
                                    <span>Contractor Master</span>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controller == "UserMaster" ? "active" : "")"
                                   asp-controller="UserMaster"
                                   asp-action="Index"
                                   title="User Master">

                                    <i class="bi bi-person-fill-gear"></i>
                                    <span>User Master</span>
                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link @(controller == "DepartmentMaster" ? "active" : "")"
                                   asp-controller="DepartmentMaster"
                                   asp-action="Index"
                                   title="Department Master">

                                    <i class="bi bi-diagram-3-fill"></i>
                                    <span>Department Master</span>
                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link @(controller == "WorkOrderMaster" ? "active" : "")"
                                   asp-controller="WorkOrderMaster"
                                   asp-action="Index"
                                   title="Work Order Master">

                                    <i class="bi bi-clipboard-check-fill"></i>
                                    <span>Work Order Master</span>
                                </a>
                            </li>


                        </ul>
                    </div>
                </li>
               
                <!-- Add your other existing menu items here -->
            </ul>
        </aside>

        <!-- MAIN AREA -->
        <div class="main-content">

            <header class="top-header">
                <div class="header-left">
                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle"
                            title="Toggle Sidebar"
                            aria-label="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="header-page-info">
                   @*      <div class="header-page-icon">
                            <i class="bi bi-grid-1x2-fill"></i>
                        </div> *@
                        <div>
                            <h1 class="header-page-title">
                                @(ViewData["Title"] ?? "Dashboard")
                            </h1>
                       @*      <div class="header-page-subtitle">
                                Contract Labour Management System
                            </div> *@
                        </div>
                    </div>
                </div>

                <div class="header-right">
                      <!-- Search -->
                        <div class="header-search">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   placeholder="Search..." />

                        </div>


                    <div class="font-controls" role="group" aria-label="Font size">
                        <button type="button" class="font-control-btn"
                                id="decreaseFont" title="Decrease font size">
                            A−
                        </button>
                        <button type="button" class="font-control-btn"
                                id="resetFont" title="Reset font size">
                            A
                        </button>
                        <button type="button" class="font-control-btn"
                                id="increaseFont" title="Increase font size">
                            A+
                        </button>
                    </div>

                    <button type="button"
                            class="user-dropdown-btn"
                            id="userDropdownButton"
                            aria-expanded="false"
                            aria-controls="userDropdownMenu"
                            aria-label="Open user menu">
                        <span class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <span class="user-info">
                            <span class="user-name">
                                @(User.Identity?.IsAuthenticated == true
                                                                ? User.Identity.Name : "Guest User")
                            </span>
                            <span class="user-role">Administrator</span>
                        </span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                </div>
            </header>

            <main class="page-content" id="pageContent">
                @RenderBody()
            </main>

            <footer class="page-footer">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <span>&copy; @DateTime.Now.Year Addsoft Technologies</span>
                    <span>Contract Labour Management System</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- User menu is outside the app wrapper so cards cannot cover it. -->
    <div id="userDropdownMenu"
         role="menu"
         aria-label="User menu"
         style="display:none; position:fixed; z-index:10000; width:220px; padding:8px; background:#fff; border:1px solid #e2e8f0; border-radius:12px; box-shadow:0 12px 35px rgba(15,23,42,.18);">

        <div class="px-3 py-2">
            <div class="fw-semibold small">
                @(User.Identity?.IsAuthenticated == true
                                ? User.Identity.Name : "Guest User")
            </div>
            <div class="text-muted small">Account options</div>
        </div>

        <hr class="dropdown-divider" />

        <a class="dropdown-item rounded py-2 px-3"
           role="menuitem"
           asp-controller="Account" asp-action="Index">
            <i class="bi bi-person me-2"></i>My Account
        </a>

        <a class="dropdown-item rounded py-2 px-3 text-danger"
           role="menuitem"
           asp-controller="Account" asp-action="Login"
           onclick="return confirm('Are you sure you want to logout?');">
            <i class="bi bi-box-arrow-right me-2"></i>Logout
        </a>
    </div>


    <script src="~/js/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    <script src="~/datatable/js/jquery.datatables.min.js"
            asp-append-version="true"></script>

    <script src="~/datatable/js/datatables.bootstrap5.min.js"
            asp-append-version="true"></script>
    <script src="~/datatable/js/datatable-init.js"></script>

    <!-- 5. Application JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>



    <script src="~/js/datatable-common.js"
            asp-append-version="true"></script>
    <script src="~/js/master-scripts.js" asp-append-version="true"> </script>

    <script src="~/js/sweetalert2.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const wrapper = document.getElementById("appWrapper");
            const sidebar = document.getElementById("mainSidebar");
            const toggle = document.getElementById("sidebarToggle");
            const overlay = document.getElementById("sidebarOverlay");

            const userButton = document.getElementById("userDropdownButton");
            const userMenu = document.getElementById("userDropdownMenu");

            const isMobile = () => window.innerWidth <= 768;

            // SIDEBAR TOGGLE
            toggle.addEventListener("click", function () {
                if (isMobile()) {
                    sidebar.classList.toggle("mobile-open");
                    overlay.classList.toggle("show");
                } else {
                    wrapper.classList.toggle("sidebar-collapsed");
                }
            });

            function closeMobileSidebar() {
                sidebar.classList.remove("mobile-open");
                overlay.classList.remove("show");
            }

            overlay.addEventListener("click", closeMobileSidebar);

            sidebar.querySelectorAll("a.nav-link").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (isMobile() && !link.hasAttribute("data-bs-toggle")) {
                        closeMobileSidebar();
                    }
                });
            });

            // POSITION USER MENU OUTSIDE THE PAGE STACKING CONTEXT
            function positionUserMenu() {
                const rect = userButton.getBoundingClientRect();
                const menuWidth = userMenu.offsetWidth || 220;
                const menuHeight = userMenu.offsetHeight || 150;

                let left = rect.right - menuWidth;
                left = Math.max(8, Math.min(left, window.innerWidth - menuWidth - 8));

                let top = rect.bottom + 8;

                if (top + menuHeight > window.innerHeight - 8) {
                    top = rect.top - menuHeight - 8;
                }

                top = Math.max(8, top);

                userMenu.style.left = left + "px";
                userMenu.style.top = top + "px";
            }

            function closeUserMenu() {
                userMenu.style.display = "none";
                userButton.setAttribute("aria-expanded", "false");
            }

            userButton.addEventListener("click", function (event) {
                event.stopPropagation();

                const isOpen = userMenu.style.display !== "none";

                if (isOpen) {
                    closeUserMenu();
                } else {
                    userMenu.style.display = "block";
                    positionUserMenu();
                    userButton.setAttribute("aria-expanded", "true");
                }
            });

            userMenu.addEventListener("click", function (event) {
                event.stopPropagation();
            });

            document.addEventListener("click", function () {
                closeUserMenu();
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    closeUserMenu();
                    closeMobileSidebar();
                }
            });

            window.addEventListener("resize", function () {
                closeUserMenu();
                if (!isMobile()) {
                    closeMobileSidebar();
                }
            });

            window.addEventListener("scroll", function () {
                if (userMenu.style.display !== "none") {
                    positionUserMenu();
                }
            }, true);

            // FONT SIZE CONTROLS
            const pageContent = document.getElementById("pageContent");
            const decreaseFont = document.getElementById("decreaseFont");
            const increaseFont = document.getElementById("increaseFont");
            const resetFont = document.getElementById("resetFont");

            const defaultFont = 14;
            let fontSize = defaultFont;

            function applyFontSize() {
                pageContent.style.fontSize = fontSize + "px";
            }

            decreaseFont.addEventListener("click", function () {
                fontSize = Math.max(12, fontSize - 1);
                applyFontSize();
            });

            increaseFont.addEventListener("click", function () {
                fontSize = Math.min(20, fontSize + 1);
                applyFontSize();
            });

            resetFont.addEventListener("click", function () {
                fontSize = defaultFont;
                applyFontSize();
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
