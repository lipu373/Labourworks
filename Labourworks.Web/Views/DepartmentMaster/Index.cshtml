@{
    ViewData["Title"] = "Department Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

<style>
    .dm-page {
        padding: 25px;
        min-height: calc(100vh - 80px);
        background: #f5f7fb;
        color: #172033;
        border-radius: 12px;
    }

    .dm-header, .dm-card-header, .dm-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .dm-header {
        margin-bottom: 22px;
    }

    .dm-title {
        margin: 0;
        font-size: 25px;
        font-weight: 750;
    }

    .dm-subtitle {
        margin-top: 6px;
        color: #64748b;
        font-size: 13px;
    }

    .dm-card {
        margin-bottom: 22px;
        overflow: hidden;
        border: 1px solid #e5eaf2;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .025);
    }

    .dm-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #edf0f5;
    }

        .dm-card-header h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
        }

    .dm-card-body {
        padding: 22px;
    }

    .dm-section-title {
        margin: 6px 0 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f5;
        color: #4f46e5;
        font-size: 13px;
        font-weight: 750;
    }

    .dm-label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 12px;
        font-weight: 650;
    }

    .dm-required {
        color: #dc2626;
    }

    .dm-input {
        display: block;
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid #dce3ed;
        border-radius: 7px;
        background: #fff;
        color: #1e293b;
        font-size: 13px;
    }

        .dm-input:focus {
            border-color: #818cf8;
            outline: none;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .10);
        }

    .dm-error {
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .dm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 9px 14px;
        border: 1px solid #dce3ed;
        border-radius: 7px;
        background: #fff;
        color: #475569;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    .dm-btn-primary {
        border-color: #4f46e5;
        background: #4f46e5;
        color: #fff;
    }

        .dm-btn-primary:hover {
            border-color: #4338ca;
            background: #4338ca;
            color: #fff;
        }

    .dm-btn:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .dm-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    #departmentTable {
        width: 100% !important;
        font-size: 12px;
    }

        #departmentTable thead th {
            padding: 13px;
            background: #f8fafc;
            color: #64748b;
            font-size: 10px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        #departmentTable tbody td {
            padding: 12px;
            vertical-align: middle;
        }

    .dm-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    .dm-status-active {
        background: #effaf2;
        color: #16803d;
    }

    .dm-status-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .dm-icon-btn {
        width: 32px;
        height: 32px;
        margin-right: 4px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #fff;
        cursor: pointer;
    }

    .dm-edit {
        color: #4f46e5;
    }

    .dm-delete {
        color: #dc2626;
    }

    .dm-count {
        color: #4f46e5;
        font-size: 12px;
        font-weight: 700;
    }

    .dm-page .dataTables_wrapper {
        padding: 16px 20px;
    }

    .dm-page .dataTables_filter input,
    .dm-page .dataTables_length select {
        padding: 7px;
        border: 1px solid #dce3ed;
        border-radius: 6px;
        font-size: 12px;
    }

    .dm-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 41px;
        font-size: 13px;
    }

    @@media(max-width: 767px) {
        .dm-page {
            padding: 12px;
        }

        .dm-card-body {
            padding: 15px;
        }

        .dm-card-header {
            padding: 15px;
        }

        .dm-title {
            font-size: 21px;
        }
    }
</style>

<div class="container-fluid dm-page">

    @Html.AntiForgeryToken()

    <div class="dm-header">
        <div>
            <div class="text-secondary small mb-2">
                Administration / Master Data / Department Master
            </div>

            <h1 class="dm-title">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>
                Department Master
            </h1>

            <div class="dm-subtitle">
                Create and manage departments.
            </div>
        </div>

        <button type="button" id="addDepartmentBtn"
                class="dm-btn dm-btn-primary">
            <i class="bi bi-plus-lg"></i> Add Department
        </button>
    </div>

    <!-- Department Form -->
    <div class="dm-card" id="departmentFormCard" style="display:none;">
        <div class="dm-card-header">
            <div>
                <h5 id="formTitle">Add Department</h5>
                <div class="dm-subtitle" id="formSubtitle">
                    Enter department details below.
                </div>
            </div>

            <span id="formMode" class="dm-count">New Record</span>
        </div>

        <div class="dm-card-body">
            <form id="departmentForm" autocomplete="off">
                <input type="hidden" id="DepartmentId" value="0" />

                <div class="dm-section-title">
                    <i class="bi bi-building me-2"></i>
                    Department Information
                </div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="dm-label" for="DepartmentName">
                            Department Name
                            <span class="dm-required">*</span>
                        </label>

                        <input type="text"
                               id="DepartmentName"
                               class="dm-input"
                               maxlength="200"
                               placeholder="Enter department name"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="dm-label">Status</label>

                        <label class="dm-checkbox">
                            <input type="checkbox" id="IsActive" checked />
                            <span>Department is active</span>
                        </label>
                    </div>
                </div>

                <div id="formError" class="dm-error mb-2"></div>

                <div class="dm-actions mt-4">
                    <button type="button" id="cancelBtn" class="dm-btn">
                        <i class="bi bi-x-lg"></i> Cancel
                    </button>

                    <button type="submit" id="saveBtn"
                            class="dm-btn dm-btn-primary">
                        <i class="bi bi-check2-circle"></i> Save Department
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Department List -->
    <div class="dm-card">
        <div class="dm-card-header">
            <div>
                <h5>
                    <i class="bi bi-list-ul text-primary me-2"></i>
                    Departments
                </h5>

                <div class="dm-subtitle">
                    View and manage department records.
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span id="listCount" class="dm-count">0 Records</span>

                <button type="button" id="refreshBtn" class="dm-btn">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>

        <div id="tableMessage" class="px-3 pt-3 text-secondary small"></div>

        <div class="dm-table-wrap">
            <table id="departmentTable" class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Department Name</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="departmentTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            let departments = [];

            function token() {
                return $('input[name="__RequestVerificationToken"]').val();
            }

            function safe(value) {
                return $('<div>')
                    .text(value == null ? '' : String(value))
                    .html();
            }

            function showMessage(message, isError = false) {
                if (window.Swal) {
                    return Swal.fire({
                        icon: isError ? 'error' : 'success',
                        title: isError ? 'Error' : 'Success',
                        text: message
                    });
                }

                alert(message);
                return Promise.resolve();
            }

            function apiError(xhr, fallback) {
                return xhr.responseJSON?.message || fallback;
            }

            function resetForm() {
                $('#departmentForm')[0].reset();

                $('#DepartmentId').val(0);
                $('#DepartmentName').val('');
                $('#IsActive').prop('checked', true);
                $('#formError').text('');

                $('#formTitle').text('Add Department');
                $('#formSubtitle').text('Enter department details below.');
                $('#formMode').text('New Record');

                $('#saveBtn').html(
                    '<i class="bi bi-check2-circle"></i> Save Department'
                );

                $('#DepartmentName').removeClass('is-invalid');
            }

            function openForm() {
                $('#departmentFormCard').stop(true, true).slideDown(200);

                $('html, body').animate({
                    scrollTop: $('#departmentFormCard').offset().top - 70
                }, 200);
            }

            function closeForm() {
                $('#departmentFormCard').stop(true, true).slideUp(200);
                resetForm();
            }

            function renderTable(data) {
                if ($.fn.DataTable.isDataTable('#departmentTable')) {
                    $('#departmentTable').DataTable().destroy();
                }

                let rows = '';

                data.forEach(function (item, index) {
                    const active = item.isActive === true;

                    const statusHtml = active
                        ? '<span class="dm-status dm-status-active">Active</span>'
                        : '<span class="dm-status dm-status-inactive">Inactive</span>';

                    let createdDate = '-';

                    if (item.createdDate) {
                        const date = new Date(item.createdDate);

                        if (!isNaN(date.getTime())) {
                            createdDate = date.toLocaleDateString('en-GB');
                        }
                    }

                    rows += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${safe(item.departmentName)}</td>
                            <td>${statusHtml}</td>
                            <td>${safe(createdDate)}</td>
                            <td>
                                <button type="button"
                                        class="dm-icon-btn dm-edit editBtn"
                                        data-id="${safe(item.departmentId)}"
                                        title="Edit department">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button type="button"
                                        class="dm-icon-btn dm-delete deleteBtn"
                                        data-id="${safe(item.departmentId)}"
                                        title="Delete department">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>`;
                });

                $('#departmentTableBody').html(rows);

                $('#listCount').text(
                    data.length +
                    (data.length === 1 ? ' Record' : ' Records')
                );

                const table = $('#departmentTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    ordering: true,
                    searching: true,
                    autoWidth: false,
                    order: [],
                    columnDefs: [
                        { targets: [0, 4], orderable: false }
                    ],
                    language: {
                        emptyTable: 'No department records available',
                        zeroRecords: 'No matching departments found',
                        search: '',
                        searchPlaceholder: 'Search departments...',
                        lengthMenu: 'Show _MENU_ entries'
                    }
                });

                table.on('draw.dt', function () {
                    const info = table.page.info();

                    table.column(0, { page: 'current' })
                        .nodes().each(function (cell, index) {
                            cell.textContent = info.start + index + 1;
                        });
                });
            }

            function loadDepartments() {
                $('#refreshBtn').prop('disabled', true);
                $('#tableMessage').text('Loading departments...');

                $.ajax({
                    url: '/DepartmentMaster/GetAll',
                    type: 'GET',
                    cache: false,

                    success: function (response) {
                        if (!response || response.status !== true) {
                            departments = [];
                            renderTable([]);

                            $('#tableMessage').text(
                                response?.message ||
                                'Unable to load departments.'
                            );
                            return;
                        }

                        departments = response.data || [];
                        renderTable(departments);
                        $('#tableMessage').text('');
                    },

                    error: function (xhr) {
                        departments = [];
                        renderTable([]);

                        $('#tableMessage').text(
                            apiError(xhr, 'Unable to load departments.')
                        );
                    },

                    complete: function () {
                        $('#refreshBtn').prop('disabled', false);
                    }
                });
            }

            function fillForm(item) {
                $('#DepartmentId').val(item.departmentId);
                $('#DepartmentName').val(item.departmentName || '');
                $('#IsActive').prop('checked', !!item.isActive);

                $('#formTitle').text('Edit Department');
                $('#formSubtitle').text('Update the selected department.');
                $('#formMode').text('Edit Record');

                $('#saveBtn').html(
                    '<i class="bi bi-check2-circle"></i> Update Department'
                );

                $('#formError').text('');

                openForm();
                $('#DepartmentName').trigger('focus');
            }

            function getDto() {
                return {
                    departmentId: Number($('#DepartmentId').val()) || 0,
                    departmentName: $('#DepartmentName').val().trim(),
                    isActive: $('#IsActive').is(':checked')
                };
            }

            $('#addDepartmentBtn').on('click', function () {
                resetForm();
                openForm();
                $('#DepartmentName').trigger('focus');
            });

            $('#cancelBtn').on('click', closeForm);
            $('#refreshBtn').on('click', loadDepartments);

            $('#departmentForm').on('submit', function (e) {
                e.preventDefault();

                if (!this.reportValidity()) {
                    return;
                }

                const dto = getDto();

                if (!dto.departmentName) {
                    $('#formError').text('Department name is required.');
                    return;
                }

                const isEdit = dto.departmentId > 0;

                const url = isEdit
                    ? '/DepartmentMaster/Update'
                    : '/DepartmentMaster/Create';

                $('#formError').text('');
                $('#saveBtn').prop('disabled', true);

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(dto),
                    headers: {
                        'RequestVerificationToken': token()
                    },

                    success: function (response) {
                        if (response && response.status === true) {
                            showMessage(response.message).then(function () {
                                closeForm();
                                loadDepartments();
                            });
                        } else {
                            $('#formError').text(
                                response?.message ||
                                'Unable to save department.'
                            );
                        }
                    },

                    error: function (xhr) {
                        $('#formError').text(
                            apiError(xhr, 'An error occurred while saving the department.')
                        );
                    },

                    complete: function () {
                        $('#saveBtn').prop('disabled', false);
                    }
                });
            });

            $('#departmentTable').on('click', '.editBtn', function () {
                const id = Number($(this).attr('data-id'));

                const item = departments.find(
                    x => Number(x.departmentId) === id
                );

                if (!item) {
                    showMessage('Department record not found.', true);
                    return;
                }

                fillForm(item);
            });

            $('#departmentTable').on('click', '.deleteBtn', function () {
                const id = Number($(this).attr('data-id'));

                const item = departments.find(
                    x => Number(x.departmentId) === id
                );

                if (!item) {
                    showMessage('Department record not found.', true);
                    return;
                }

                function deleteDepartment() {
                    $.ajax({
                        url: '/DepartmentMaster/Delete?id=' +
                            encodeURIComponent(id),
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': token()
                        },

                        success: function (response) {
                            if (response && response.status === true) {
                                showMessage(response.message)
                                    .then(loadDepartments);
                            } else {
                                showMessage(
                                    response?.message ||
                                    'Unable to delete department.',
                                    true
                                );
                            }
                        },

                        error: function (xhr) {
                            showMessage(
                                apiError(xhr, 'An error occurred while deleting the department.'),
                                true
                            );
                        }
                    });
                }

                if (window.Swal) {
                    Swal.fire({
                        title: 'Delete Department?',
                        text: 'Are you sure you want to delete "' +
                            item.departmentName + '"?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, delete',
                        confirmButtonColor: '#dc3545'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            deleteDepartment();
                        }
                    });
                } else if (confirm(
                    'Are you sure you want to delete "' +
                    item.departmentName + '"?'
                )) {
                    deleteDepartment();
                }
            });

            loadDepartments();
        });
    </script>
}
